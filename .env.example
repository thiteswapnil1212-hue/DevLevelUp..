# =============================================================
# BACKEND environment variables — /backend/.env.example
# Copy this file to .env and fill in real values.
# In Railway, set these under Service → Variables tab instead.
# =============================================================

# GitHub personal access token (classic, read-only public repos is enough)
GITHUB_TOKEN=your_github_token_here

# Port the server listens on (Railway injects this automatically)
PORT=5000

# Ollama AI endpoint (only needed when running locally with Ollama installed)
OLLAMA_URL=http://localhost:11434/api/generate
